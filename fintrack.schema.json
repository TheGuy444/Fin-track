{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theguy444.github.io/Fin-track/fintrack.schema.json",
  "title": "FinTrack file (fintrack.json)",
  "description": "A person's own finances in one file they keep. Loaded by the FinTrack dashboard and edited by AI assistants following the _agent rules. Version 3.",
  "type": "object",
  "required": ["fintrack", "version"],
  "properties": {
    "fintrack": { "const": "profile" },
    "version": { "const": 3 },
    "$schema": { "type": "string" },
    "_readme": { "type": "string", "description": "Plain-language note for the owner." },
    "_agent": {
      "type": "object",
      "description": "Instructions for AI assistants that manage this file.",
      "properties": {
        "what": { "type": "string" },
        "spec": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "revision": { "type": "integer", "minimum": 0, "description": "Goes up by 1 on every change. Higher = newer." },
    "updatedAt": { "type": "string", "description": "ISO 8601 date-time of the last change." },
    "updatedBy": { "type": "string", "examples": ["app", "assistant"] },
    "settings": {
      "type": "object",
      "properties": {
        "currency": { "enum": ["USD", "CAD", "EUR", "GBP", "AUD", "NZD", "INR", "JPY", "MXN", "ZAR", "CHF", "SEK", "NOK", "DKK", "SGD", "PHP", "BRL"] },
        "planBudget": { "type": ["number", "null"], "minimum": 0, "description": "Total monthly amount for the payoff plan; null = sum of card payments." },
        "strategy": { "enum": ["avalanche", "snowball"] }
      }
    },
    "cards": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/card" } },
    "bills": { "type": "array", "maxItems": 300, "items": { "$ref": "#/$defs/bill" } },
    "income": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/income" } },
    "history": { "type": "array", "items": { "$ref": "#/$defs/historyEntry" } },
    "transactions": { "type": "array", "items": { "$ref": "#/$defs/transaction" } },
    "log": { "type": "array", "items": { "$ref": "#/$defs/logEntry" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$", "description": "Short unique id, e.g. \"chase-visa\". Unique across the whole file." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "money": { "type": "number", "minimum": 0 },
    "frequency": { "enum": ["weekly", "biweekly", "monthly", "quarterly", "yearly", "once"] },
    "card": {
      "type": "object",
      "required": ["id", "name", "balance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 60, "description": "Nickname only. Never a card number." },
        "balance": { "$ref": "#/$defs/money", "description": "What is owed right now." },
        "apr": { "type": "number", "minimum": 0, "maximum": 100, "description": "Percent: 24.99 means 24.99%." },
        "payment": { "$ref": "#/$defs/money", "description": "What the owner actually pays each month." },
        "min": { "$ref": "#/$defs/money", "description": "Minimum payment." },
        "limit": { "$ref": "#/$defs/money", "description": "Credit limit." },
        "dueDay": { "type": "integer", "minimum": 1, "maximum": 31, "description": "Day of the month the payment is due." },
        "autopay": { "type": "boolean" },
        "lastPaid": { "$ref": "#/$defs/date", "description": "Optional; FinTrack also uses the latest payment in history." },
        "startBalance": { "$ref": "#/$defs/money", "description": "Balance when tracking started, for progress." },
        "target": { "type": "integer", "minimum": 1, "maximum": 600, "description": "Goal: paid off within this many months." },
        "step": { "$ref": "#/$defs/money" },
        "notes": { "type": "string", "maxLength": 300 }
      }
    },
    "bill": {
      "type": "object",
      "required": ["id", "name", "amount", "frequency"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 60 },
        "amount": { "$ref": "#/$defs/money" },
        "category": { "type": "string", "maxLength": 40 },
        "frequency": { "$ref": "#/$defs/frequency" },
        "dueDay": { "type": "integer", "minimum": 1, "maximum": 31, "description": "Required for monthly. Short months use their last day." },
        "nextDue": { "$ref": "#/$defs/date", "description": "Required for weekly, biweekly, quarterly, yearly and once: any real due date; it repeats from there." },
        "autopay": { "type": "boolean" },
        "variable": { "type": "boolean", "description": "Amount changes; amount is an estimate." },
        "card": { "type": "string", "description": "id of the card this bill is charged to, if any." },
        "lastPaid": { "$ref": "#/$defs/date" },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "allOf": [
        { "if": { "properties": { "frequency": { "const": "monthly" } } }, "then": { "anyOf": [ { "required": ["dueDay"] }, { "required": ["nextDue"] } ] }, "else": { "required": ["nextDue"] } }
      ]
    },
    "income": {
      "type": "object",
      "required": ["id", "name", "amount", "frequency"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 60 },
        "amount": { "$ref": "#/$defs/money", "description": "Take-home amount each time." },
        "category": { "type": "string", "maxLength": 40 },
        "frequency": { "$ref": "#/$defs/frequency" },
        "dueDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "nextDue": { "$ref": "#/$defs/date", "description": "Next (or any real) pay date." },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "allOf": [
        { "if": { "properties": { "frequency": { "const": "monthly" } } }, "then": { "anyOf": [ { "required": ["dueDay"] }, { "required": ["nextDue"] } ] }, "else": { "required": ["nextDue"] } }
      ]
    },
    "historyEntry": {
      "type": "object",
      "required": ["card", "date", "kind", "amount"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "card": { "type": "string", "description": "Card id." },
        "date": { "$ref": "#/$defs/date" },
        "kind": { "enum": ["payment", "charge"] },
        "amount": { "$ref": "#/$defs/money" },
        "note": { "type": "string", "maxLength": 120 }
      }
    },
    "transaction": {
      "type": "object",
      "required": ["date", "type", "amount"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/date" },
        "type": { "enum": ["income", "expense"] },
        "amount": { "$ref": "#/$defs/money" },
        "category": { "type": "string", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 120 },
        "card": { "type": "string", "description": "Card id, if charged to a card." },
        "bill": { "type": "string", "description": "Bill id, if this paid a bill." }
      }
    },
    "logEntry": {
      "type": "object",
      "properties": {
        "rev": { "type": "integer" },
        "at": { "type": "string" },
        "by": { "type": "string" },
        "summary": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
